<!--
  HTTP — SCADA HMI login page with Siemens CP443-1 banner.

  XSD constraint: <global>/<headers>/<entity> has maxOccurs=1 (single
  entity allowed in the global headers block). The substation Server and
  X-Powered-By banners are therefore set per-node under /<headers>/<entity>
  (which IS maxOccurs="unbounded"). Date stays in global so the
  update_header_date logic refreshes it on each response.

  No /tests/unittest_* nodes — those are upstream-Conpot dev fixtures and a
  known fingerprint.
-->
<http enabled="True" host="0.0.0.0" port="8800">
    <global>
        <config>
            <entity name="protocol_version">HTTP/1.1</entity>
            <entity name="update_header_date">true</entity>
            <entity name="disable_method_head">false</entity>
            <entity name="disable_method_trace">false</entity>
            <entity name="disable_method_options">false</entity>
            <entity name="tarpit">0</entity>
        </config>

        <headers>
            <!-- Single global header (XSD permits one). Refreshed live when
                 update_header_date=true. Per-node Server/X-Powered-By
                 banners override below. -->
            <entity name="Date">Sat, 28 Apr 1984 07:30:00 GMT</entity>
        </headers>
    </global>

    <htdocs>
        <node name="/">
            <!-- 302 redirect to /index.html. Server banner is set here so
                 even an HTTP HEAD of `/` returns the Siemens CP443-1 string. -->
            <status>302</status>
            <headers>
                <entity name="Content-Type">text/html</entity>
                <entity name="Location">/index.html</entity>
                <entity name="Server">Siemens CP443-1 Advanced V3.3.0</entity>
                <entity name="X-Powered-By">SIMATIC WinCC</entity>
            </headers>
        </node>
        <node name="/index.html">
            <tarpit>0</tarpit>
            <headers>
                <entity name="Last-Modified">Tue, 19 May 1993 09:00:00 GMT</entity>
                <entity name="Content-Type">text/html</entity>
                <entity name="Server">Siemens CP443-1 Advanced V3.3.0</entity>
                <entity name="X-Powered-By">SIMATIC WinCC</entity>
            </headers>
        </node>
        <node name="/index.htm">
            <alias>/index.html</alias>
        </node>

        <!-- ================================================================
             Credential bait (Phase 2 step H4, SIR-006-05).

             Two paths, because a WinCC-fronted S7 serves two kinds of login
             and an attacker tries both:

               /hmi/    HTTP Basic. Answers 401 with
                        `WWW-Authenticate: Basic realm="SIMATIC HMI"`, so any
                        client — `curl -u`, a browser, a credential-stuffing
                        tool — volunteers an `Authorization: Basic` header on
                        the retry. The forwarder decodes it.
               /login   The POST target the start page's form has always
                        advertised. Until H4 it had no node at all, so the
                        form's own action returned 404: both a tell that the
                        page is scenery, and a guarantee that every credential
                        typed into it was thrown away. It now answers 403 with
                        a "credentials rejected" page.

             Both are STATIC. Conpot 0.6.0's `load_entity` reads `<status>`
             and `<headers>` per node for GET and POST alike
             (command_responder.py:433-442, reached from do_GET:867 and
             do_POST:935), so a POST gets the identical rejection a GET does
             and no protocol-handler patch is needed. That is also the
             security property that matters here: no credential comparison
             exists anywhere in this path, so there is no pair — default or
             otherwise — that can produce a success page suggesting a real
             device is reachable behind the login.

             `Cache-Control: no-store` on both: an intermediary that cached
             the 401 would break the challenge/retry the capture depends on.
             ================================================================ -->
        <node name="/hmi/index.html">
            <status>401</status>
            <tarpit>0</tarpit>
            <headers>
                <entity name="Content-Type">text/html</entity>
                <entity name="WWW-Authenticate">Basic realm="SIMATIC HMI"</entity>
                <entity name="Cache-Control">no-store</entity>
                <entity name="Server">Siemens CP443-1 Advanced V3.3.0</entity>
                <entity name="X-Powered-By">SIMATIC WinCC</entity>
            </headers>
        </node>
        <node name="/hmi/">
            <alias>/hmi/index.html</alias>
        </node>
        <node name="/hmi">
            <alias>/hmi/index.html</alias>
        </node>
        <node name="/hmi/denied.html">
            <status>403</status>
            <tarpit>0</tarpit>
            <headers>
                <entity name="Content-Type">text/html</entity>
                <entity name="Cache-Control">no-store</entity>
                <entity name="Server">Siemens CP443-1 Advanced V3.3.0</entity>
                <entity name="X-Powered-By">SIMATIC WinCC</entity>
            </headers>
        </node>
        <node name="/login">
            <alias>/hmi/denied.html</alias>
        </node>
    </htdocs>

    <!-- ====================================================================
         Status codes (step H11).

         A code declared here needs a matching `http/statuscodes/<code>.status`
         file beside `htdocs/`: `load_status` (command_responder.py:266-276)
         opens `<docpath>/statuscodes/<code>.status`, and `docpath` is
         `<template>/http`. Until H11 this persona shipped the XML block and
         none of the files, so every request for a path with no htdocs node
         logged `FileNotFoundError .../http/statuscodes/404.status` and
         answered with a zero-length body — on an internet-exposed sensor
         that is one traceback per scanner probe and a content-free reply to
         the single most common thing a scanner does.

         403 and 503 are declared and shipped even though nothing routes to
         them today: 403 is reachable only through `send_error`, 503 only
         through the proxy fallback. A device that answers 404 with a branded
         page and 503 with nothing is odder than one that answers both.

         Two upstream limits, worth knowing before trying to fix them here:
         `<entity name="Content-Type">` under `<status>` is read by no code
         path in Conpot 0.6.0, and http.xsd gives `<status>` no `<headers>`
         child at all — so a status response carries the one global header
         (Date) plus Content-Length, and the persona's Server banner cannot be
         attached to it from the template. Both belong to the HTTP responder,
         not to this file.
         ==================================================================== -->
    <statuscodes>
        <status name="400">
            <tarpit>0</tarpit>
            <entity name="Content-Type">text/html</entity>
        </status>
        <status name="403">
            <tarpit>0</tarpit>
            <entity name="Content-Type">text/html</entity>
        </status>
        <status name="404">
            <tarpit>0</tarpit>
            <entity name="Content-Type">text/html</entity>
        </status>
        <status name="501">
            <tarpit>0</tarpit>
            <entity name="Content-Type">text/html</entity>
        </status>
        <status name="503">
            <tarpit>0</tarpit>
            <entity name="Content-Type">text/html</entity>
        </status>
    </statuscodes>
</http>
