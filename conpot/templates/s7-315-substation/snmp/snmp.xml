<?xml version="1.0" encoding="utf-8"?>
<!--
  SNMP agent for the IronMonkey S7-315-2 PN/DP substation persona
  (Phase 2 step H10). Bound internally on 16100; the host publishes 161/udp
  (sensors/docker-compose.sensor.yml). Conpot runs as a non-root user, so the
  internal port has to stay above 1024, and snmp.xsd types the port attribute
  as xs:short, so it also has to stay below 32768.

  Persona: a Siemens S7-300 with a PN/DP interface answers SNMP natively, so
  this needs no invention — every value below is served out of the databus
  keys template.xml already carried for exactly this purpose. sysObjectID is
  Siemens AG's IANA enterprise arc (1.3.6.1.4.1.4196).

  OPSEC: nothing here repeats an upstream Conpot default. The default template
  answers sysDescr "Siemens, SIMATIC, S7-200" and sysLocation "Venus", both of
  which identify a Conpot instance rather than a PLC.

  sysLocation is deliberately EMPTY rather than absent. Substation siting is
  part of the OPSEC surface so it must not be disclosed, but a device that
  returns noSuchObject for sysLocation while answering sysName and sysContact
  is itself odd; an unset sysLocation is the ordinary field state.

  A SET is accepted with the read community, which is upstream Conpot's
  behaviour (the VACM grant covers write on 1.3.6.1.2.1) and a realistic
  misconfiguration for a device of this age. Writes land in the in-memory
  databus and are lost on container restart — see docs/honeypot-ops.md.

  DoS-evasion thresholds are req_per_ip/minute;req_overall/minute; over the
  threshold, the responder answers nothing. They are tighter than the upstream
  defaults, and tightest on bulk, because an internet-exposed SNMP agent is a
  reflection/amplification lever and GETBULK is the arm of it that pays: one
  small request, one large answer. Ordinary scanning and ordinary operator
  polling sit far below these numbers.
-->
<snmp enabled="True" host="0.0.0.0" port="16100">
    <config>
        <!-- Response delays, in seconds: lower;upper of a uniform draw. -->
        <entity name="tarpit" command="get">0.1;0.2</entity>
        <entity name="tarpit" command="set">0.1;0.2</entity>
        <entity name="tarpit" command="next">0.0;0.1</entity>
        <entity name="tarpit" command="bulk">0.2;0.4</entity>

        <!-- req_per_ip/minute;req_overall/minute -->
        <entity name="evasion" command="get">60;180</entity>
        <entity name="evasion" command="set">20;60</entity>
        <entity name="evasion" command="next">120;300</entity>
        <entity name="evasion" command="bulk">12;30</entity>
    </config>
    <mibs>
        <mib name="SNMPv2-MIB">
            <symbol name="sysDescr">
                <!-- Every <value> below is a databus key, not a literal.
                     Keep commentary inside <symbol>, never as a direct child
                     of <mib>: SNMPServer.xml_mib_config iterates the mib
                     element's children with a plain `for`, which in lxml
                     yields comment nodes too, and then reads .attrib["name"]
                     off them. A comment one level up kills the SNMP greenlet
                     at startup with a bare KeyError. -->
                <value>sysDescription</value>
            </symbol>
            <symbol name="sysObjectID">
                <value>sysObjectID</value>
            </symbol>
            <symbol name="sysUpTime">
                <value>Uptime</value>
            </symbol>
            <symbol name="sysContact">
                <value>sysContact</value>
            </symbol>
            <symbol name="sysName">
                <value>sysName</value>
            </symbol>
            <symbol name="sysLocation">
                <value>sysLocation</value>
            </symbol>
            <symbol name="sysServices">
                <value>sysServices</value>
            </symbol>
        </mib>
    </mibs>
</snmp>
